/* ============================================================
   Care Calendar — main stylesheet
   Rebuilt 2026-10-25

   Structure:
     1. Colour tokens (user-themeable)
     2. Base reset & typography
     3. Layout
     4. Top navigation
     5. Buttons
     6. Forms
     7. Flash messages
     8. Toasts
     9. Modals
    10. Day view
    11. Event view
    12. History
    13. Threads (Louisa's thoughts / Family messages)
    14. Kind chooser (Add something page)
    15. Settings landing
    16. Profile
    17. Who's in this calendar
    18. Week view
    19. Floating action buttons
    20. Today button / Return today
    21. Responsive overrides

   Theming note:
     --c-primary, --c-primary-h and --c-primary-fg are designed
     to be overridden per-user via an inline <style> block in the
     page head. Everything that should follow a user's chosen
     colour uses these variables.
   ============================================================ */

/* ---------- 1. Colour tokens ---------- */

:root {
    /* Primary — user-themeable (nav bar, links, buttons) */
    --c-primary:    #0b4f6c;
    --c-primary-h:  #093f56;
    --c-primary-fg: #ffffff;

    /* Accent — user-themeable (today/restore highlights) */
    --c-today:      #d97a1b;
    --c-today-dark: #b56212;

    /* Semantic */
    --c-danger:     #a11414;
    --c-success:    #0b5c30;
    --c-warning:    #8a5300;

    /* Surfaces & text */
    --c-bg:         #ffffff;
    --c-surface:    #f7f9fb;
    --c-text:       #14202a;
    --c-muted:      #465a6b;
    --c-border:     #d3dce3;

    /* Thread colours (not user-themeable by default) */
    --c-thoughts-bg:    #fff8ee;
    --c-thoughts-edge:  #e6c78a;
    --c-thoughts-text:  #8a5300;
    --c-messages-bg:    #eef4f9;
    --c-messages-edge:  #b8d0e0;
    --c-messages-text:  #0b4f6c;

    /* Sizing */
    --radius:    12px;
    --radius-sm: 8px;
    --gap:       16px;
    --gap-lg:    24px;

    /* Type scale */
    --fs-body: 18px;
    --fs-lg:   20px;
    --fs-xl:   24px;
    --fs-2xl:  32px;
    --fs-3xl:  40px;
    --lh-body: 1.5;

    /* Touch target */
    --tap-min: 48px;
}

/* ---------- 2. Base reset & typography ---------- */

* { box-sizing: border-box; }

html, body {
    margin: 0;
    padding: 0;
    background: var(--c-bg);
    color: var(--c-text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    -webkit-text-size-adjust: 100%;
}

img, svg, video, iframe { max-width: 100%; height: auto; }

:focus-visible {
    outline: 3px solid var(--c-primary);
    outline-offset: 2px;
}

body.modal-open { overflow: hidden; }

/* ---------- 3. Layout ---------- */

.main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 20px 100px;
}

.footer {
    text-align: center;
    padding: 20px;
    color: var(--c-muted);
    border-top: 1px solid var(--c-border);
}

/* ---------- 4. Top navigation ---------- */

.topbar {
    display: block;
    padding: 0;
}

.topbar__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
}

.topbar__row--primary {
    background: var(--c-primary);
    color: var(--c-primary-fg);
    border-bottom: 1px solid rgba(255,255,255,0.12);
}

.topbar__row--secondary {
    background: var(--c-primary-h);
    color: var(--c-primary-fg);
    justify-content: center;
}

.topbar__row--views {
    background: var(--c-primary-h);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 8px 20px 10px;
    justify-content: center;
}

.topbar__brand {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-primary-fg);
    text-decoration: none;
    letter-spacing: 0.2px;
    margin-right: auto;
}

.topbar__actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--radius-sm);
    background: transparent;
    border: 2px solid rgba(255,255,255,0.4);
    color: var(--c-primary-fg);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
}

.iconbtn:hover { background: rgba(255,255,255,0.15); }
.iconbtn:active { transform: translateY(1px); }

.iconbtn--wide {
    width: auto;
    padding: 0 20px;
    font-size: var(--fs-body);
    font-weight: 600;
}

/* Date navigation */

.datenav {
    display: flex;
    align-items: center;
    gap: 20px;
    justify-content: center;
    width: 100%;
    max-width: 900px;
}

.navbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--tap-min);
    padding: 10px 20px;
    font-size: var(--fs-body);
    font-weight: 600;
    font-family: inherit;
    color: var(--c-primary-fg);
    background: rgba(255,255,255,0.14);
    border: 2px solid rgba(255,255,255,0.5);
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    white-space: nowrap;
}

.navbtn:hover { background: rgba(255,255,255,0.24); }
.navbtn:active { transform: translateY(1px); }

.navbtn__arrow { font-size: 1.4em; line-height: 1; font-weight: 700; }

.datenav__label {
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--c-primary-fg);
    text-align: center;
    flex: 1;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.3px;
}

.datenav__today-tag {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    opacity: 0.7;
    margin-right: 10px;
    vertical-align: 3px;
}

/* View switcher */

.viewtabs {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
}

.viewtabs a,
.viewtabs span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 8px 20px;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--c-primary-fg);
    background: rgba(255,255,255,0.10);
    border: 2px solid rgba(255,255,255,0.35);
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
}

.viewtabs a:hover { background: rgba(255,255,255,0.22); }

.viewtabs a.is-active {
    background: var(--c-primary-fg);
    color: var(--c-primary);
    border-color: var(--c-primary-fg);
}

.viewtabs .is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

/* ---------- 5. Buttons ---------- */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--tap-min);
    padding: 12px 22px;
    font-size: var(--fs-lg);
    font-weight: 600;
    font-family: inherit;
    line-height: 1;
    border: 2px solid transparent;
    border-radius: var(--radius);
    background: var(--c-primary);
    color: var(--c-primary-fg);
    cursor: pointer;
    text-decoration: none;
    transition: background-color 120ms ease;
    -webkit-tap-highlight-color: transparent;
}

.btn:hover { background: var(--c-primary-h); }
.btn:active { transform: translateY(1px); }

.btn--ghost {
    background: transparent;
    border-color: rgba(255,255,255,0.6);
    color: var(--c-primary-fg);
}
.btn--ghost:hover { background: rgba(255,255,255,0.15); }

.btn--danger {
    background: var(--c-danger);
    color: #ffffff;
}
.btn--danger:hover { background: #7d0f0f; }

.btn--block { display: flex; width: 100%; }

.btn--small {
    padding: 6px 14px;
    font-size: var(--fs-body);
    min-height: auto;
    border-radius: var(--radius-sm);
}

/* ---------- 6. Forms ---------- */

.form {
    max-width: 520px;
    margin: 40px auto;
    padding: 28px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
}

.form--wide { max-width: 720px; }

.form__brand {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--c-primary);
    text-align: center;
}

.form__title {
    margin: 0 0 24px;
    font-size: var(--fs-2xl);
    line-height: 1.2;
}

.form__row { margin-bottom: 20px; }

.form__row--half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.form__label {
    display: block;
    margin-bottom: 8px;
    font-size: var(--fs-body);
    font-weight: 600;
}

.form__help {
    display: block;
    margin-top: 6px;
    font-size: 0.9em;
    color: var(--c-muted);
}

.form__input,
.form__textarea,
.form__select {
    display: block;
    width: 100%;
    min-height: var(--tap-min);
    padding: 12px 14px;
    font-size: var(--fs-lg);
    font-family: inherit;
    line-height: 1.4;
    color: var(--c-text);
    background: #ffffff;
    border: 2px solid var(--c-border);
    border-radius: var(--radius-sm);
}

.form__textarea {
    min-height: 120px;
    line-height: 1.5;
    resize: vertical;
}

.form__input:focus,
.form__textarea:focus,
.form__select:focus {
    border-color: var(--c-primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(11,79,108,0.2);
}

.form__check {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-body);
}

.form__check input[type="checkbox"] {
    width: 26px;
    height: 26px;
    accent-color: var(--c-primary);
}

.form__error {
    margin: 0 0 16px;
    padding: 12px 16px;
    background: #fdecec;
    border-left: 5px solid var(--c-danger);
    color: var(--c-danger);
    font-weight: 600;
    border-radius: var(--radius-sm);
}

.form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
}

/* ---------- 7. Flash messages ---------- */

.flashes {
    max-width: 720px;
    margin: 20px auto;
    padding: 0 16px;
}

.flash {
    padding: 14px 18px;
    margin-bottom: 10px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    border-left: 5px solid;
}

.flash--error   { background: #fdecec; border-color: var(--c-danger);  color: var(--c-danger); }
.flash--success { background: #e7f5ec; border-color: var(--c-success); color: var(--c-success); }
.flash--info    { background: #eaf2f7; border-color: var(--c-primary); color: var(--c-primary); }
.flash--warning { background: #fff5e2; border-color: var(--c-warning); color: var(--c-warning); }

/* ---------- 8. Toasts ---------- */

.toast-container {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 380px;
    width: calc(100% - 40px);
    pointer-events: none;
    align-items: center;
}

.toast {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 44px 14px 20px;
    background: #ffffff;
    color: var(--c-text);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0,0,0,0.16), 0 2px 6px rgba(0,0,0,0.08);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.3;
    border-left: 6px solid var(--c-primary);
    opacity: 0;
    transform: translateY(-12px);
    transition: opacity 220ms ease, transform 220ms ease;
    pointer-events: auto;
}

.toast.is-visible { opacity: 1; transform: translateY(0); }
.toast.is-leaving { opacity: 0; transform: translateY(-12px); }

.toast--success { border-left-color: var(--c-success); }
.toast--error   { border-left-color: var(--c-danger);  }
.toast--warning { border-left-color: var(--c-warning); }
.toast--info    { border-left-color: var(--c-primary); }

.toast__close {
    position: absolute;
    top: 8px;
    right: 8px;
    background: transparent;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--c-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    font-family: inherit;
}

.toast__close:hover {
    background: var(--c-surface);
    color: var(--c-text);
}

/* ---------- 9. Modals ---------- */

.modal-backdrop {
    position: fixed;
    top: 0; right: 0; bottom: 0; left: 0;
    background: rgba(8, 24, 36, 0.55);
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: modal-fade-in 160ms ease;
}

.modal-backdrop[hidden] { display: none; }

@keyframes modal-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.modal {
    background: #ffffff;
    border-radius: var(--radius);
    width: 100%;
    max-width: 640px;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    overflow: hidden;
    animation: modal-rise 200ms ease;
}

@keyframes modal-rise {
    from { transform: translateY(20px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
}

.modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: var(--c-primary);
    color: var(--c-primary-fg);
}

.modal__title {
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
}

.modal__subtitle {
    font-size: var(--fs-body);
    margin: 4px 0 0;
    opacity: 0.85;
}

.modal__close {
    flex: 0 0 auto;
    background: transparent;
    border: 2px solid rgba(255,255,255,0.5);
    color: var(--c-primary-fg);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal__close:hover { background: rgba(255,255,255,0.15); }

.modal__body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 20px 24px;
    background: var(--c-surface);
}

.modal__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.modal__item {
    background: #ffffff;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--c-primary);
}

.modal__who {
    font-weight: 700;
    color: var(--c-text);
    margin-right: 8px;
}

.modal__when {
    font-size: 14px;
    color: var(--c-muted);
    font-weight: 600;
}

.modal__text {
    margin-top: 6px;
    font-size: var(--fs-lg);
    line-height: 1.45;
    color: var(--c-text);
    word-wrap: break-word;
    white-space: pre-wrap;
}

.modal__empty {
    text-align: center;
    color: var(--c-muted);
    font-style: italic;
    padding: 30px 0;
}

.modal__form {
    flex: 0 0 auto;
    padding: 20px 24px;
    background: #ffffff;
    border-top: 1px solid var(--c-border);
}

.modal__label {
    display: block;
    font-size: var(--fs-body);
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--c-text);
}

.modal__textarea {
    width: 100%;
    padding: 12px 14px;
    font-size: var(--fs-lg);
    font-family: inherit;
    line-height: 1.5;
    color: var(--c-text);
    background: #fff;
    border: 2px solid var(--c-border);
    border-radius: var(--radius-sm);
    resize: vertical;
    min-height: 80px;
}

.modal__textarea:focus {
    border-color: var(--c-primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(11,79,108,0.2);
}

.modal__actions {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    flex-wrap: wrap;
}

.modal__cancel {
    background: var(--c-surface);
    color: var(--c-primary);
    border-color: var(--c-border);
}

.modal__past-note {
    padding: 14px 20px;
    background: #fff5e2;
    color: var(--c-warning);
    font-weight: 600;
    font-size: var(--fs-body);
    text-align: center;
    border-top: 1px solid var(--c-border);
}

/* ---------- 10. Day view ---------- */

.day { max-width: 900px; margin: 0 auto; }

.day__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--c-border);
}

.day__item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 16px 8px;
    border-bottom: 2px solid var(--c-border);
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    transition: background-color 100ms ease;
}

.day__item:hover,
.day__item:focus { background: var(--c-surface); }

.day__time {
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--c-primary);
    line-height: 1.2;
}

.day__time-all-day {
    font-size: var(--fs-body);
    color: var(--c-muted);
    font-weight: 500;
}

.day__body { min-width: 0; }

.day__title {
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0 0 4px;
    line-height: 1.25;
    word-wrap: break-word;
}

.day__meta {
    font-size: var(--fs-body);
    color: var(--c-muted);
    margin: 2px 0;
    line-height: 1.4;
}

.day__description {
    font-size: var(--fs-body);
    margin: 6px 0 0;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
}

.day__icon {
    display: inline-block;
    margin-right: 6px;
    font-size: 1.1em;
    vertical-align: -0.1em;
}

.day__empty {
    text-align: center;
    padding: 32px 20px;
    color: var(--c-muted);
    font-size: var(--fs-xl);
}

.day__empty p { margin: 4px 0; }

/* Deleted section (collapsed) */

.deleted-section {
    margin-top: 36px;
    padding-top: 16px;
    border-top: 2px dashed var(--c-border);
}

.deleted-section > summary {
    list-style: none;
    cursor: pointer;
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 6px 0;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 8px;
}

.deleted-section > summary::-webkit-details-marker { display: none; }

.deleted-section > summary::after {
    content: "▸";
    font-size: 1em;
    transition: transform 120ms ease;
    color: var(--c-muted);
    margin-left: 4px;
}

.deleted-section[open] > summary::after { transform: rotate(90deg); }
.deleted-section > summary:hover { color: var(--c-primary); }
.deleted-section[open] > summary { margin-bottom: 4px; }

.day__list--deleted {
    border-top: none;
    padding: 0;
    margin: 0;
}

.day__list--deleted .day__item--deleted {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px 10px 12px;
    margin-bottom: 6px;
    border-left: 4px solid var(--c-danger);
    border-bottom: 1px solid var(--c-border);
    background: #fdf6f6;
    border-radius: 6px 0 0 6px;
    opacity: 0.9;
}

.day__list--deleted .day__item--deleted .day__time {
    flex: 0 0 auto;
    min-width: 72px;
    font-size: var(--fs-body);
    font-weight: 700;
}

.day__list--deleted .day__item--deleted .day__body {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    min-width: 0;
}

.day__list--deleted .day__title {
    flex: 0 0 auto;
    font-size: var(--fs-body);
    margin: 0;
    font-weight: 700;
    color: var(--c-muted);
    text-decoration: line-through;
    text-decoration-color: rgba(161,20,20,0.4);
    text-decoration-thickness: 2px;
}

.day__list--deleted .day__meta {
    flex: 1 1 auto;
    margin: 0;
    font-size: var(--fs-body);
    color: var(--c-muted);
    min-width: 0;
}

.restore-form {
    flex: 0 0 auto;
    margin: 0;
}

/* ---------- 11. Event view ---------- */

.event { max-width: 780px; margin: 0 auto; }

.event__title {
    font-size: var(--fs-3xl);
    margin: 0 0 12px;
    line-height: 1.2;
    word-wrap: break-word;
}

.event__meta {
    font-size: var(--fs-lg);
    color: var(--c-muted);
    margin: 8px 0;
}

.event__label {
    display: inline-block;
    min-width: 100px;
    font-weight: 600;
    color: var(--c-text);
}

.event__section {
    margin: 28px 0;
    padding: 24px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
}

.event__section h2 {
    font-size: var(--fs-xl);
    margin: 0 0 12px;
}

.event__desc {
    white-space: pre-wrap;
    line-height: 1.55;
    margin: 0;
}

.event__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
}

/* ---------- 12. History ---------- */

.history { list-style: none; padding: 0; margin: 0; }

.history li {
    padding: 14px 0;
    border-bottom: 1px solid var(--c-border);
}

.history li:last-child { border-bottom: none; }

.history__when { font-size: var(--fs-body); font-weight: 700; }
.history__who  { font-size: var(--fs-body); color: var(--c-muted); margin: 4px 0; }
.history__what { font-size: var(--fs-body); margin: 4px 0 0; }

.history__reason {
    margin-top: 6px;
    padding: 8px 12px;
    background: #fff5e2;
    border-left: 4px solid var(--c-warning);
    border-radius: var(--radius-sm);
    font-size: var(--fs-body);
}

/* ---------- 13. Threads ---------- */

.thread {
    max-width: 900px;
    margin: 0 auto 20px;
    padding: 12px 18px 10px;
    border-radius: var(--radius);
    border: 2px solid var(--c-border);
    position: relative;
}

.thread--thoughts {
    background: var(--c-thoughts-bg);
    border-color: var(--c-thoughts-edge);
}

.thread--messages {
    background: var(--c-messages-bg);
    border-color: var(--c-messages-edge);
}

.thread__header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
}

.thread__header .thread__open {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
    min-width: 0;
}

.thread__open {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 4px 0 6px;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
}

.thread__open--body {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
}

.thread__header .thread__icon {
    font-size: 1.1em;
    line-height: 1;
    flex: 0 0 auto;
}

.thread__header .thread__name {
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.2;
    flex: 1 1 auto;
}

.thread--thoughts .thread__header .thread__name { color: var(--c-thoughts-text); }
.thread--messages .thread__header .thread__name { color: var(--c-messages-text); }

.thread__header .thread__unread {
    flex: 0 0 auto;
    background: var(--c-danger);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.thread__unread {
    margin-left: auto;
    background: var(--c-danger);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}

.thread__add-link {
    flex: 0 0 auto;
    padding: 2px 0;
    background: transparent;
    border: none;
    color: var(--c-primary);
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    -webkit-tap-highlight-color: transparent;
    white-space: nowrap;
}

.thread__add-link:hover { color: var(--c-primary-h); }

.thread__empty {
    display: block;
    text-align: center;
    font-style: italic;
    color: var(--c-muted);
    font-size: 15px;
    padding: 2px 0 4px;
}

.thread__preview {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.thread__row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: var(--fs-body);
    line-height: 1.3;
    overflow: hidden;
    white-space: nowrap;
}

.thread__who {
    font-weight: 700;
    color: var(--c-text);
    flex: 0 0 auto;
}

.thread__time {
    font-size: 14px;
    color: var(--c-muted);
    font-weight: 600;
    flex: 0 0 auto;
}

.thread__body {
    color: var(--c-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1 1 auto;
    min-width: 0;
}

.thread__more {
    display: inline-block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--c-muted);
    font-style: italic;
}

/* ---------- 14. Kind chooser (Add something page) ---------- */

.kindchooser { margin: 0 0 28px; }

.kindchooser__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.kindchooser__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 22px 14px;
    background: #ffffff;
    border: 3px solid var(--c-border);
    border-radius: var(--radius);
    cursor: pointer;
    font-family: inherit;
    text-align: center;
    transition: border-color 120ms ease, background-color 120ms ease, transform 120ms ease;
    -webkit-tap-highlight-color: transparent;
}

.kindchooser__btn:hover {
    border-color: var(--c-primary);
    transform: translateY(-2px);
}

.kindchooser__btn.is-selected {
    border-color: var(--c-primary);
    background: #eef4f9;
    box-shadow: 0 0 0 3px rgba(11,79,108,0.15);
}

.kindchooser__icon {
    font-size: 40px;
    line-height: 1;
}

.kindchooser__title {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-text);
    line-height: 1.2;
}

.kindchooser__sub {
    font-size: 15px;
    color: var(--c-muted);
    line-height: 1.2;
}

.kindform__heading {
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0 0 6px;
}

.kindform__help {
    font-size: var(--fs-body);
    color: var(--c-muted);
    margin: 0 0 18px;
    line-height: 1.4;
}

/* ---------- 15. Settings landing ---------- */

.settings { max-width: 720px; margin: 0 auto; }

.settings__title {
    font-size: var(--fs-3xl);
    font-weight: 700;
    margin: 8px 0 28px;
    text-align: center;
}

.settings__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.settings-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
    background: var(--c-surface);
    border: 2px solid var(--c-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-text);
    transition: background-color 100ms ease, border-color 100ms ease, transform 100ms ease;
    -webkit-tap-highlight-color: transparent;
}

.settings-card:hover,
.settings-card:focus {
    background: #eef3f8;
    border-color: var(--c-primary);
    transform: translateY(-1px);
}

.settings-card__icon {
    flex: 0 0 auto;
    font-size: 34px;
    width: 46px;
    text-align: center;
    line-height: 1;
}

.settings-card__body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
}

.settings-card__title {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-text);
}

.settings-card__sub {
    font-size: var(--fs-body);
    color: var(--c-muted);
    line-height: 1.3;
    word-wrap: break-word;
}

.settings-card__chevron {
    flex: 0 0 auto;
    font-size: 32px;
    line-height: 1;
    color: var(--c-muted);
    margin-left: 6px;
}

.settings__footer {
    margin-top: 32px;
    text-align: center;
}

/* ---------- 16. Profile ---------- */

.profile-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 20px;
}

.profile-card__title {
    font-size: var(--fs-xl);
    font-weight: 700;
    margin: 0 0 6px;
}

.profile-card__help {
    font-size: 15px;
    color: var(--c-muted);
    margin: 0 0 18px;
    line-height: 1.4;
}

/* ---------- 17. Who's in this calendar ---------- */

.who-intro {
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--c-muted);
    margin: 0 auto 28px;
    max-width: 620px;
    text-align: center;
}

.who-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.who-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--c-surface);
    border: 2px solid var(--c-border);
    border-radius: var(--radius);
}

.who-card--subject {
    background: #f0f6fa;
    border-color: var(--c-primary);
}

.who-card--pending {
    background: #fff8ee;
    border-style: dashed;
    border-color: var(--c-warning);
    opacity: 0.9;
}

.who-avatar {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--c-primary);
    color: var(--c-primary-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.who-card--subject .who-avatar {
    background: var(--c-today);
}

.who-card--pending .who-avatar {
    background: var(--c-warning);
    font-size: 24px;
}

.who-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.who-name {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.25;
    color: var(--c-text);
}

.who-badge {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    background: var(--c-primary);
    color: var(--c-primary-fg);
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
    vertical-align: middle;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.who-role {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--c-primary);
}

.who-desc {
    font-size: 15px;
    color: var(--c-muted);
    line-height: 1.35;
}

.who-section-title {
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 32px 0 12px;
}

/* ---------- 18. Week view ---------- */

.week { max-width: 1400px; margin: 0 auto; }

.week__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-top: 20px;
}

.week__day {
    background: #fff;
    border: 2px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 320px;
}

.week__day.is-today {
    border-color: var(--c-primary);
    background: #f0f6fa;
    box-shadow: 0 0 0 3px rgba(11,79,108,0.15);
}

.week__day-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 8px 10px;
    background: var(--c-surface);
    border-bottom: 2px solid var(--c-border);
    text-decoration: none;
    color: var(--c-text);
}

.week__day.is-today .week__day-header {
    background: var(--c-primary);
    color: var(--c-primary-fg);
    border-bottom-color: var(--c-primary-h);
}

.week__day-name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    opacity: 0.75;
}

.week__day.is-today .week__day-name { opacity: 0.9; }

.week__day-num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    margin: 2px 0;
}

.week__day-month {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.75;
}

.week__day-body {
    flex: 1 1 auto;
    padding: 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.week__empty {
    text-align: center;
    color: var(--c-muted);
    margin: 20px 0;
    opacity: 0.4;
    font-size: var(--fs-lg);
}

.week__event {
    display: block;
    padding: 8px 10px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-left: 4px solid var(--c-primary);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--c-text);
    font-size: 15px;
    line-height: 1.3;
    transition: background-color 100ms ease, transform 100ms ease;
}

.week__event:hover,
.week__event:focus {
    background: var(--c-surface);
    transform: translateY(-1px);
}

.week__event-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary);
    margin-bottom: 3px;
    line-height: 1.1;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(11,79,108,0.12);
}

.week__event-icon {
    font-size: 14px;
    margin: 0;
}

.week__event-time {
    margin: 0;
    color: var(--c-primary);
    font-size: 13px;
    font-weight: 700;
}

.week__event-title {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.28;
    color: var(--c-text);
    overflow-wrap: break-word;
    word-break: normal;
}

/* Week view thread summary */

.week__thread {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    transition: background-color 100ms ease;
    -webkit-tap-highlight-color: transparent;
}

.week__thread--thoughts {
    background: var(--c-thoughts-bg);
    color: var(--c-thoughts-text);
    border: 1px solid var(--c-thoughts-edge);
}
.week__thread--thoughts:hover { background: #ffefd1; }

.week__thread--messages {
    background: var(--c-messages-bg);
    color: var(--c-messages-text);
    border: 1px solid var(--c-messages-edge);
}
.week__thread--messages:hover { background: #d9e8f2; }

.week__thread__icon {
    font-size: 1.05em;
    line-height: 1;
    flex: 0 0 auto;
}

.week__thread__count {
    font-weight: 800;
    flex: 0 0 auto;
}

.week__thread__word {
    font-weight: 600;
    opacity: 0.9;
    flex: 1 1 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.week__day-divider {
    display: block;
    height: 2px;
    background: rgba(11, 79, 108, 0.35);
    border-radius: 1px;
    margin: 6px 0 8px;
}

/* ---------- 19. Floating action button (day view) ---------- */

.fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    font-size: var(--fs-xl);
    font-weight: 700;
    font-family: inherit;
    color: var(--c-primary-fg);
    background: var(--c-primary);
    border: none;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0,0,0,0.18);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    z-index: 50;
}

.fab:hover { background: var(--c-primary-h); }
.fab:active { transform: translateY(1px); }

/* Past-day / week-view non-active FAB with speech bubble */

.fab--hint {
    background: var(--c-muted);
    opacity: 0.8;
    cursor: pointer;
}

.fab--hint:hover {
    background: var(--c-muted);
    opacity: 0.9;
}

.fab-wrap {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
}

.fab-wrap .fab {
    position: static;
    display: inline-flex;
}

.fab-bubble {
    position: absolute;
    bottom: calc(100% + 12px);
    right: 0;
    padding: 10px 16px;
    background: var(--c-text);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.28);
    max-width: 260px;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 180ms ease, transform 180ms ease;
    pointer-events: none;
}

.fab-bubble.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.fab-bubble::after {
    content: "";
    position: absolute;
    bottom: -8px;
    right: 26px;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid var(--c-text);
}

/* ---------- 20. Today button / Return today ---------- */

.todaybtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 18px;
    font-size: var(--fs-body);
    font-weight: 700;
    font-family: inherit;
    color: #ffffff;
    background: var(--c-today);
    border: 2px solid var(--c-today-dark);
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.todaybtn:hover { background: var(--c-today-dark); }
.todaybtn:active { transform: translateY(1px); }

.return-today {
    text-align: center;
    margin: 12px 0 20px;
}

.return-today .todaybtn {
    padding: 12px 26px;
    font-size: var(--fs-lg);
}

/* ---------- 21. Responsive ---------- */

@media (max-width: 1100px) {
    .week__grid { grid-template-columns: repeat(4, 1fr); }
    .week__event-title { font-size: 14px; }
    .week__event-meta  { font-size: 12px; }
}

@media (max-width: 900px) {
    .datenav__label { font-size: var(--fs-xl); }
    .datenav__today-tag { font-size: 12px; }
    .week__grid { grid-template-columns: repeat(2, 1fr); }
    .week__day { min-height: 200px; }
}

@media (max-width: 760px) {
    .navbtn__text { display: none; }
    .navbtn { padding: 10px 14px; }
    .datenav { gap: 10px; }
    .datenav__label { font-size: var(--fs-lg); }
    .datenav__today-tag { font-size: 11px; margin-right: 6px; }
    .todaybtn { padding: 6px 12px; font-size: var(--fs-body); }
}

@media (max-width: 700px) {
    .topbar__row--views { padding: 6px 8px 8px; }
    .viewtabs { gap: 4px; flex-wrap: nowrap; }
    .viewtabs a,
    .viewtabs span {
        min-height: 36px;
        padding: 6px 10px;
        font-size: 14px;
        border-width: 2px;
        flex: 1 1 0;
        min-width: 0;
    }
    .iconbtn--wide {
        padding: 0 12px;
        font-size: 15px;
        white-space: nowrap;
        width: auto;
        height: auto;
        min-height: 40px;
    }
    .topbar__brand { font-size: 16px; }
    .topbar__actions { gap: 6px; }

    .thread { padding: 10px 14px 8px; margin-bottom: 14px; }
    .thread__row { font-size: 15px; }
    .thread__empty { font-size: 14px; }
    .thread__add-link { font-size: 14px; }

    .week__thread {
        font-size: 12px;
        padding: 4px 6px;
        gap: 4px;
    }
    .week__event-title { font-size: 15px; }
    .week__event-meta  { font-size: 13px; }

    .modal__header { padding: 16px 16px; }
    .modal__title { font-size: var(--fs-lg); }
    .modal__body { padding: 16px; }
    .modal__form { padding: 16px; }
    .modal__close { width: 40px; height: 40px; font-size: 22px; }

    .who-card { padding: 14px 14px; gap: 12px; }
    .who-avatar { width: 44px; height: 44px; font-size: 18px; }
    .who-name { font-size: var(--fs-body); }
    .who-desc { font-size: 14px; }
}

@media (max-width: 600px) {
    :root { --fs-body: 17px; --fs-lg: 18px; --fs-2xl: 26px; }
    .topbar__row { padding: 8px 12px; }
    .topbar__brand { font-size: var(--fs-body); }
    .iconbtn { width: 44px; height: 44px; font-size: 22px; }

    .main { padding: 12px 12px 100px; }

    .form { margin: 20px 12px; padding: 20px; }
    .form__row--half { grid-template-columns: 1fr; }

    .day__item {
        grid-template-columns: 90px 1fr;
        gap: 14px;
        padding: 12px 4px;
    }
    .day__time { font-size: var(--fs-lg); }
    .day__title { font-size: var(--fs-lg); }

    .day__list--deleted .day__item--deleted {
        flex-wrap: wrap;
    }
    .day__list--deleted .day__item--deleted .day__meta {
        flex-basis: 100%;
        margin-top: 4px;
    }
    .restore-form {
        flex-basis: 100%;
        margin-top: 6px;
    }

    .settings__title { font-size: var(--fs-2xl); margin-bottom: 20px; }
    .settings-card { padding: 16px 16px; gap: 14px; }
    .settings-card__icon { font-size: 28px; width: 36px; }
    .settings-card__title { font-size: var(--fs-lg); }
    .settings-card__sub { font-size: 15px; }

    .fab {
        right: 12px;
        bottom: 12px;
        padding: 14px 22px;
        font-size: var(--fs-lg);
    }

    .fab-wrap {
        right: 12px;
        bottom: 12px;
    }
    .fab-bubble {
        font-size: 14px;
        padding: 8px 12px;
        max-width: 220px;
        white-space: normal;
    }

    .return-today { margin: 16px 0 24px; }
    .return-today .todaybtn { padding: 10px 20px; font-size: var(--fs-body); }

     .toast-container {
        top: 10px;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        width: calc(100% - 20px);
        max-width: none;
    }
}

@media (max-width: 500px) {
    .kindchooser__form { grid-template-columns: 1fr; gap: 10px; }
    .kindchooser__btn { padding: 16px 12px; }
    .kindchooser__icon { font-size: 32px; }
    .kindchooser__title { font-size: var(--fs-body); }

    .week__grid { grid-template-columns: 1fr; }
    .week__day-num { font-size: 26px; }
}

@media (max-width: 400px) {
    .viewtabs a,
    .viewtabs span {
        padding: 6px 6px;
        font-size: 13px;
    }
}
